{
  "name": "evenfield",
  "version": "3.1.1",
  "private": true,
  "description": "Evenfield: the whole Ammora launch day in one place. Spot the coins worth your money, read the receipts on the human behind them, buy in two taps, and launch your own when you are ready. GIWA Sepolia testnet, built with the official @ammora-protocol/sdk.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "snapshot": "node scripts/build-snapshot.mjs",
    "census": "node scripts/census.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@ammora-protocol/sdk": "0.3.9",
    "@wagmi/connectors": "8.2.4",
    "@wagmi/core": "3.6.9",
    "@walletconnect/ethereum-provider": "2.26.0",
    "viem": "2.57.20"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
